{
    "definition": {
        "version": 1,
        "pages": [{ "key": "main", "title": "Main" }],
        "fields": [
            { "key": "total", "kind": "computed", "page": "main", "label": "Total", "width": "full", "required": false, "hidden": false, "decimals": 0, "expression": { "add": [{ "var": "subtotal" }, { "var": "tax" }] } },
            { "key": "tax", "kind": "computed", "page": "main", "label": "Tax", "width": "full", "required": false, "hidden": false, "decimals": 0, "expression": { "round": [{ "div": [{ "mul": [{ "sumOf": [{ "var": "lines" }, "taxable_amount"] }, { "var": "tax_pct" }] }, 100] }, 0] } },
            { "key": "subtotal", "kind": "computed", "page": "main", "label": "Subtotal", "width": "full", "required": false, "hidden": false, "decimals": 0, "expression": { "sumOf": [{ "var": "lines" }, "amount"] } },
